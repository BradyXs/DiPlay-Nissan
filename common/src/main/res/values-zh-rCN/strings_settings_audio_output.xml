    <string name="settings_carplay_call_volume">CarPlay 通话音量</string>
    <string name="settings_nissan_phone_hardware_volume">日产原厂电话音量</string>
    <string name="settings_nissan_phone_hardware_volume_description">原厂电话音量，范围 0–15，立即生效。它也会改变原厂电话声音；是否影响 CarPlay 通话需在通话中实测。</string>
    <string name="settings_carplay_volume_description">滑动调节三类 CarPlay 声音相对车机音量的大小，立即生效。进度条获得焦点时，音量键可按 5% 调节。车载蓝牙模式的音量由车机控制。</string>





    <string name="settings_carplay_audio_output">CarPlay 音频输出</string>
    <string name="settings_carplay_audio_output_description">开启：声音通过 CarPlay 播放。关闭：DiPlay 只传画面；请在 iPhone 上选择车载蓝牙播放声音。关闭后，CarPlay 通话、Siri 和导航语音也不会通过 CarPlay 输出。重新连接 CarPlay 后生效。</string>
    <string name="settings_nissan_audio_mode">音频输出模式</string>
    <string name="settings_nissan_audio_bluetooth">车载蓝牙</string>
    <string name="settings_nissan_audio_carplay">CarPlay</string>
    <string name="settings_nissan_audio_mode_description">车载蓝牙：保持蓝牙开启，在 iPhone 上选择车载蓝牙输出，DiPlay 只接收画面。CarPlay：由 DiPlay 接收音频，在 Wi-Fi 交接、首帧显示且音频流建立后关闭车机蓝牙。重新连接 CarPlay 后生效。</string>
