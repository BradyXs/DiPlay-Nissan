<resources>
    <style name="Theme.Xcertplay" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2C9FF5</item>
        <item name="android:navigationBarColor">#12151B</item>
        <item name="android:statusBarColor">#12151B</item>
        <item name="android:windowBackground">#12151B</item>
        <item name="android:alertDialogTheme">@style/Theme.Xcertplay.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Xcertplay.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#2C9FF5</item>
        <item name="android:windowBackground">@drawable/bg_dp_dialog</item>
        <item name="android:textColorPrimary">#F8F9FC</item>
        <item name="android:textColorSecondary">#BFC4CD</item>
    </style>
</resources>
